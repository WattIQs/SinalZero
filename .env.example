# Frontend — public configuration
# These values are safe to expose to the browser when using Supabase publishable keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Search — only add these if/when this integration is actually used by SinalZero.
# Never commit real credentials.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Brevo is NOT a frontend variable.
# Brevo credentials belong exclusively to Supabase Edge Functions / Supabase secrets.

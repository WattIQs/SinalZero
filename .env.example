# Vercel environment variables — configure the real values only in Vercel.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
TURNSTILE_SECRET_KEY=
# Opt-in only: the native DuckDB + remote Parquet Overture query is disabled
# by default on serverless. Set to true only after validating its runtime.
OVERTURE_ENABLED=false

